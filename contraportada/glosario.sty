\newglossaryentry{LoRaWAN}
{
    name=LoRaWAN,
    description={Protocolo y arquitectura de red de área amplia y bajo consumo que utiliza LoRa como tecnología de comunicación física entre los dispositivos finales y la infraestructura de red}
}

\newglossaryentry{LoRa}
{
    name=LoRa,
    description={Tecnología de modulación de radio de largo alcance y baja potencia utilizada como capa física en redes LoRaWAN}
}

\newglossaryentry{Computacion de frontera}
{
    name=Computación de frontera,
    description={Es un tipo de informática que ocurre en la ubicación física del usuario, de la fuente de datos, o cerca de ellas.}
}

\newglossaryentry{Contenedor}
{
    name=Contenedor,
    description={Un contenedor es un paquete estandarizado de software que se puede implementar de forma rápida y confiable en la nube y otros entornos para admitir una 
    innovación rápida y eficaz. Los contenedores permiten a los desarrolladores empaquetar una aplicación con todas las partes que necesita, como bibliotecas y otras dependencias, 
    y enviarla todo como un paquete.}
}

\newglossaryentry{Docker}
{
    name=Docker,
    description={Es una plataforma de software de código abierto para crear, implementar y administrar contenedores de aplicaciones virtualizados en un sistema operativo (SO) común, 
    con un ecosistema de herramientas aliadas}
}

\newglossaryentry{puerta-enlace}
{
    name={Puerta de enlace},
    description={Equipo que recibe las transmisiones de radio de los dispositivos LoRaWAN y las reenvía al servidor de red mediante una conexión IP}
}

\newglossaryentry{nodo-final}
{
    name={Nodo final},
    description={Dispositivo LoRaWAN que recopila datos o ejecuta una acción y se comunica por radio con una o más puertas de enlace}
}

\newglossaryentry{servidor-red}
{
    name={Servidor de red},
    description={Componente LoRaWAN que gestiona la red, valida los mensajes recibidos y coordina la entrega de mensajes a los dispositivos}
}

\newglossaryentry{servidor-aplicacion}
{
    name={Servidor de aplicación},
    description={Componente LoRaWAN que procesa los datos de aplicación de los dispositivos y los entrega a las aplicaciones o integraciones correspondientes}
}

\newglossaryentry{the-things-stack}
{
    name={The Things Stack},
    description={Plataforma de software para desplegar y administrar redes LoRaWAN, dispositivos finales, puertas de enlace y aplicaciones}
}

\newacronym{iot}{IoT}{Internet de las cosas}
\newacronym{mqtt}{MQTT}{Message Queuing Telemetry Transport}
\newacronym{rssi}{RSSI}{indicador de fuerza de señal recibida}
\newacronym{sf}{SF}{factor de dispersión}
\newacronym{api}{API}{interfaz de programación de aplicaciones}
\newacronym{json}{JSON}{JavaScript Object Notation}